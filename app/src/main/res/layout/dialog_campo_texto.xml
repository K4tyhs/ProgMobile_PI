<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de texto reutilizado em diálogos (recuperar senha, código do evento) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/rotulo_campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:labelFor="@id/edt_campo"
        android:textAppearance="@style/TextAppearance.PE.Rotulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edt_campo"
        style="@style/Widget.PE.Campo.Claro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:importantForAutofill="no"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rotulo_campo" />
</androidx.constraintlayout.widget.ConstraintLayout>
