# Copie para .env e ajuste. Nunca coloque segredos aqui: tudo que começa
# com VITE_ vai parar no código que roda no navegador.

# URL base da API Node/Express (sem barra no final). Usada a partir da Fase 0 da API.
VITE_API_URL=http://localhost:3333

# Tipo de rota: browser (padrão, produção), hash ou memory (só para prévias/links de demonstração).
VITE_ROUTER=browser

# "true" mostra o usuário de teste na tela de login fora do modo dev.
VITE_SHOW_TEST_LOGIN=false
